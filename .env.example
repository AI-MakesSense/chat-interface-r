# =============================================================================
# REQUIRED
# The app will not boot / authenticate without these.
# =============================================================================

# PostgreSQL connection string (Neon / Vercel Postgres / local).
DATABASE_URL=postgresql://user:password@localhost:5432/n8n_widget_designer

# Secret used to sign JWT auth tokens. MUST be at least 32 characters.
# Generate with: openssl rand -base64 32
JWT_SECRET=generate-with-openssl-rand-base64-32

# =============================================================================
# OPTIONAL — sensible defaults apply when unset
# =============================================================================

# Public URL used in embed-code / loader generation.
# Should match your deployment domain. Falls back to VERCEL_PROJECT_PRODUCTION_URL,
# then the request origin, when unset.
# Also used as the trusted first-party domain for widget domain authorization.
# MUST be set in production or first-party embeds (dashboard/demo pages) will 403.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Standard Node environment. Defaults to "development" locally.
NODE_ENV=development

# Set automatically by Vercel (production deployments) — no protocol prefix.
# Used as a fallback origin for embed-code generation. Leave unset locally.
# VERCEL_PROJECT_PRODUCTION_URL=

# Admin access. Comma-separated list of emails granted admin privileges
# (admin guard / tier management). Empty = no admins.
ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# Feature flags (default OFF / n8n-only mode)
# -----------------------------------------------------------------------------

# ChatKit / Agent surfaces. Keep disabled for n8n-only mode.
NEXT_PUBLIC_ENABLE_CHATKIT=false
ENABLE_CHATKIT=false

# OpenAI API base for ChatKit session creation. Only read when ChatKit is enabled.
# Defaults to https://api.openai.com when unset.
# CHATKIT_API_BASE=https://api.openai.com

# Billing mutations (upgrade/cancel). Defaults to FALSE — tiers are
# admin-managed until Stripe integration ships. Set true only when the
# STRIPE_* vars below are configured.
BILLING_ENABLED=

# -----------------------------------------------------------------------------
# Rate limiting (Upstash Redis via Vercel Marketplace)
# Optional — when both are empty the app falls back to an in-memory limiter.
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Stripe (optional — only needed when BILLING_ENABLED=true; not currently read
# by the app, billing is disabled)
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRICE_BASIC=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_AGENCY=price_...

# -----------------------------------------------------------------------------
# Sentry (optional — error tracking)
# The DSN is hardcoded in sentry.*.config.ts / instrumentation*.ts.
# For source-map upload at build time, set SENTRY_AUTH_TOKEN in
# .env.sentry-build-plugin (gitignored). org/project are set in next.config.ts.
# -----------------------------------------------------------------------------
# SENTRY_AUTH_TOKEN=
